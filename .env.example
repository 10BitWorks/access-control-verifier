BIND=0.0.0.0:8000
MASTER_KEY=placeholder_master_key_32bytes_hexadecimal
MASTER_KEY_FUTURE=placeholder_future_key_32bytes_hexadecimal
EMQX_SHARED_SECRET=your_emqx_shared_secret_here
MQTT_HOST=mqtt.local
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=verifier
