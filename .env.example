BIND=0.0.0.0:8000
MASTER_KEY=placeholder_master_key_32bytes_hexadecimal
MASTER_KEY_FUTURE=placeholder_future_key_32bytes_hexadecimal
EMQX_SHARED_SECRET=your_emqx_shared_secret_here
MQTT_HOST=mqtt.local
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=verifier
MQTT_PASSWORD=verifier_pass
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_TOKEN=your_authentik_api_token
AUTHENTIK_GROUP=status_current
SYNC_INTERVAL_MINUTES=60
GRACE_DAYS=5
LOCKOUT_DAYS=10
ACL_EXPIRY_DAYS=35
ACL_PUSH_PERIOD_MINUTES=60
ADMIN_BEARER_TOKEN=your_admin_api_token
EMQX_API_URL=https://emqx.local:18083
EMQX_API_KEY=your_emqx_api_key
DATA_DIR=/data

# Self-service key portal & OIDC configuration
AUTHENTIK_ISSUER=https://auth.example.com
AUTHENTIK_CLIENT_ID=your_authentik_oidc_client_id
AUTHENTIK_CLIENT_SECRET=your_authentik_oidc_client_secret
PUBLIC_URL=https://keys.example.com
SESSION_SECRET=your_random_32char_session_secret
SESSION_LIFETIME_HOURS=12
ADMIN_ROLE=Onboarder
